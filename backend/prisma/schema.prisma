generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailJob {
  id          String   @id @default(uuid())
  recipient   String
  subject     String
  body        String
  status      String   @default("SCHEDULED")
  scheduledAt DateTime
  senderId    String
  slackToken  String?
  createdAt   DateTime @default(now())
}

model UserSettings {
  id           String   @id @default(uuid())
  senderId     String   @unique
  slackWebhook String?  // Slack se notification bhejne ke liye
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}